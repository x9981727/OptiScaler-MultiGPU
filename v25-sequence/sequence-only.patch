+++ b/OptiScaler/framegen/ManagedXeFGSequence.h
@@ -0,0 +1,17 @@
+#pragma once
+#include <cstdint>
+#include <limits>
+
+namespace MultiGPU
+{
+// One ID per actual compositor protocol attempt, NOT per outer Present.
+// An incomplete original-only packet never calls XeLL Sleep/markers and must
+// not advance their sequence. This addresses the observed gap on reactivation.
+// It does not repair the worker timeline/pacing algorithm or image contents.
+inline std::uint32_t NextManagedXeFGId(std::uint32_t& last, bool complete) noexcept
+{
+    if (!complete || last == (std::numeric_limits<std::uint32_t>::max)())
+        return 0; // original-only fallback; recreate context before wraparound
+    return ++last;
+}
+}
