 HRESULT STDMETHODCALLTYPE WrappedIDXGISwapChain4::QueryInterface(REFIID riid, void** ppvObject)
@@ -642,6 +800,19 @@ HRESULT STDMETHODCALLTYPE WrappedIDXGISwapChain4::GetParent(REFIID riid, void**
 //
 HRESULT STDMETHODCALLTYPE WrappedIDXGISwapChain4::GetDevice(REFIID riid, void** ppDevice)
 {
+    if (_multiGpuVirtualBackbufferReady)
+    {
+        if (_device != nullptr)
+        {
+            auto hr = _device->QueryInterface(riid, ppDevice);
+            if (SUCCEEDED(hr))
+                return hr;
+        }
+
+        if (_multiGpuRenderDevice != nullptr)
+            return _multiGpuRenderDevice->QueryInterface(riid, ppDevice);
+    }
+
     return _real->GetDevice(riid, ppDevice);
 }
 
