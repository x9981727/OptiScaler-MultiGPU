+bool CrossAdapterTextureBridge::RecordFGImport(ID3D12GraphicsCommandList* fgCmdList, ID3D12Resource* fgTarget,
+                                                D3D12_RESOURCE_STATES targetState)
+{
+    if (_runtime == nullptr || !_runtime->IsActive() || fgCmdList == nullptr || fgTarget == nullptr ||
+        _fgSharedBuffer == nullptr)
+        return false;
+
+    const auto targetDesc = fgTarget->GetDesc();
+    if (targetDesc.Dimension != _sourceDesc.Dimension || targetDesc.Width != _sourceDesc.Width ||
+        targetDesc.Height != _sourceDesc.Height || targetDesc.DepthOrArraySize != _sourceDesc.DepthOrArraySize ||
+        targetDesc.MipLevels != _sourceDesc.MipLevels || targetDesc.Format != _sourceDesc.Format ||
+        targetDesc.SampleDesc.Count != _sourceDesc.SampleDesc.Count)
+        return false;
+
+    Transition(fgCmdList, _fgSharedBuffer.Get(), _fgSharedState, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    Transition(fgCmdList, fgTarget, targetState, D3D12_RESOURCE_STATE_COPY_DEST);
+
+    D3D12_TEXTURE_COPY_LOCATION src {};
+    src.pResource = _fgSharedBuffer.Get();
+    src.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    src.PlacedFootprint = _footprint;
+
+    D3D12_TEXTURE_COPY_LOCATION dst {};
+    dst.pResource = fgTarget;
+    dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    dst.SubresourceIndex = 0;
+
+    fgCmdList->CopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+
+    Transition(fgCmdList, _fgSharedBuffer.Get(), D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOU