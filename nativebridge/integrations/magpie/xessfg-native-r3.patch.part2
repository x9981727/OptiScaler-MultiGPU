+static void BuildNativeViewMatrix(const nb::Camera& camera, float out[16]) noexcept {
+	const float* r = camera.right;
+	const float* u = camera.up;
+	const float* f = camera.forward;
+	const float* p = camera.position;
+	out[0]=r[0]; out[1]=u[0]; out[2]=f[0]; out[3]=0.0f;
+	out[4]=r[1]; out[5]=u[1]; out[6]=f[1]; out[7]=0.0f;
