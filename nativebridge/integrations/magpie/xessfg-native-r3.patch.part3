+void XeSSFGPresenter::SetNativeFrameGuidance(
+	ID3D11Texture2D* motion,
+	ID3D11Texture2D* depth,
+	const nb::Camera& camera,
+	FrameGuidanceFrameId frameId,
+	bool requiresHistoryReset,
+	const RECT& destinationRect
+) noexcept {
+	if (!_impl || !_impl->nativeGuidanceEnabled) return;
+	Impl& impl = *_impl;
+	impl.guidanceFrameId = frameId;
+	impl.externalMotionValid = false;
+	impl.nativeGuidanceValid = false;
+	impl.externalMotionReset = true;
+	impl.nativeGuidanceReset = true;
+	if (!motion || !depth || !impl.motion11 || !impl.motionUav11 || !impl.depth11 ||
+		!impl.depthUav11 || frameId == 0 || frameId <= impl.lastSubmittedGuidanceFrameId ||
+		(camera.flags & nb::Orthographic)) return;
+	D3D11_TEXTURE2D_DESC motionDesc{}, depthDesc{};
+	motion->GetDesc(&motionDesc);
+	depth->GetDesc(&depthDesc);
+	const LONG width = destinationRect.right - destinationRect.left;
+	const LONG height = destinationRect.bottom - destinationRect.top;
+	if (motionDesc.Format != DXGI_FORMAT_R16G16_FLOAT ||
+		depthDesc.Format != DXGI_FORMAT_R32_FLOAT || motionDesc.Width != depthDesc.Width ||
+		motionDesc.Height != depthDesc.Height || destinationRect.left < 0 ||
+		destinationRect.top < 0 || destinationRect.right > static_cast<LONG>(impl.width) ||
+		destinationRect.bottom > static_cast<LONG>(impl.height) ||
+		width != static_cast<LONG>(motionDesc.Width) ||
+		height != static_cast<LONG>(motionDesc.Height)) {
+		Logger::Get().Warn("XeSSFG NativeBridge depth/motion extent mismatch; native guidance dropped");
+		return;
+	}
+	uint32_t desiredFlags = XEFG_SWAPCHAIN_INIT_FLAG_NONE;
+	if (camera.flags & nb::DepthInverted) desiredFlags |= XEFG_SWAPCHAIN_INIT_FLAG_INVERTED_DEPTH;
+	if (!RecreateProxyForNativeFlags(impl, desiredFlags)) {
+		Logger::Get().Error("XeSSFG NativeBridge depth convention reinitialization failed");
+		return;
+	}
+	static constexpr float ZERO[4]{};
+	const float FAR_DEPTH[4]{
+		(camera.flags & nb::DepthInverted) ? 0.0f : 1.0f,
+		(camera.flags & nb::DepthInverted) ? 0.0f : 1.0f,
+		(camera.flags & nb::DepthInverted) ? 0.0f : 1.0f,
+		(camera.flags & nb::DepthInverted) ? 0.0f : 1.0f };
+	impl.context11->ClearUnorderedAccessViewFloat(impl.motionUav11.get(), ZERO);
+	impl.context11->ClearUnorderedAccessViewFloat(impl.depthUav11.get(), FAR_DEPTH);
+	impl.context11->CopySubresourceRegion(impl.motion11.get(), 0,
+		static_cast<UINT>(destinationRect.left), static_cast<UINT>(destinationRect.top), 0,
+		motion, 0, nullptr);
+	impl.context11->CopySubresourceRegion(impl.depth11.get(), 0,
+		static_cast<UINT>(destinationRect.left), static_cast<UINT>(destinationRect.top), 0,
+		depth, 0, nullptr);
+	impl.nativeCamera = camera;
+	impl.externalMotionValid = true;
+	impl.nativeGuidanceValid = true;
+	impl.externalMotionReset = requiresHistoryReset;
+	impl.nativeGuidanceReset = requiresHistoryReset ||
+		(camera.flags & nb::Reset) ||
+		(impl.lastSubmittedGuidanceFrameId != 0 && frameId != impl.lastSubmittedGuidanceFrameId + 1);
+}
